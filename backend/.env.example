# Server port (Vercel sets this automatically in production)
PORT=5000

# Environment
NODE_ENV=development

# JWT secret — use your existing value, keep it consistent across local and production
JWT_SECRET=your_jwt_secret_here

# JWT expiry
JWT_EXPIRY=7d

# PostgreSQL connection string (Vercel Postgres sets this automatically)
# Leave empty to use SQLite locally
DATABASE_URL=

# Your deployed Vercel frontend URL (needed for CORS in production)
# Example: https://spendo.vercel.app
FRONTEND_URL=
